.inbound-page { padding-bottom: 40rpx; }
.page-header {
  background: linear-gradient(135deg, #c0392b, #8e1c1c);
  padding: 40rpx 32rpx;
  color: #fff;
}
.page-header .title { font-size: 36rpx; font-weight: 600; }
.page-header .sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }

.placeholder { color: #95a5a6; }

.ai-card { border-left: 6rpx solid #3498db; }
.ai-result { padding: 8rpx 0; }
.ai-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx dashed #ecf0f1;
}
.ai-row:last-child { border-bottom: none; }
.ai-row text:first-child { color: #7f8c8d; }
.ai-warning {
  padding: 16rpx;
  background: #fdecea;
  border-radius: 8rpx;
  font-size: 26rpx;
}
.flow-steps {
  margin-top: 12rpx;
  padding: 12rpx;
  background: #f5f6fa;
  border-radius: 8rpx;
}
.flow-step {
  padding: 6rpx 0;
  font-size: 24rpx;
  color: #34495e;
}

.actions { padding: 24rpx; }
