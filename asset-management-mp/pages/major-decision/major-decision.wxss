.md-page { padding-bottom: 40rpx; }
.page-header { background: linear-gradient(135deg, #c0392b, #8e1c1c); padding: 40rpx 32rpx; color: #fff; }
.page-header .title { font-size: 36rpx; font-weight: 600; }
.page-header .sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.actions { padding: 24rpx; }
.md-item { padding: 16rpx 0; border-bottom: 1rpx solid #ecf0f1; }
.md-item:last-child { border-bottom: none; }
.md-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.md-no { font-size: 22rpx; color: #95a5a6; }
.md-title { font-size: 28rpx; font-weight: 500; color: #2c3e50; margin-bottom: 8rpx; }
.md-meta { display: flex; justify-content: space-between; font-size: 24rpx; color: #34495e; margin-bottom: 4rpx; }
.md-meta .amount { color: #c0392b; }
.md-trigger { font-size: 22rpx; color: #e74c3c; }
.md-process { font-size: 22rpx; color: #3498db; margin-top: 8rpx; text-align: right; }
