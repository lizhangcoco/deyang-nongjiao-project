.ex-page { padding-bottom: 40rpx; }
.page-header { background: linear-gradient(135deg, #c0392b, #8e1c1c); padding: 40rpx 32rpx; color: #fff; }
.page-header .title { font-size: 36rpx; font-weight: 600; }
.page-header .sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.actions { padding: 24rpx; }
.check-result { margin: 16rpx 0; }
.check-row { padding: 12rpx; border-radius: 8rpx; font-size: 24rpx; margin-bottom: 8rpx; }
.check-row.pass { background: #e8f8f0; color: #27ae60; }
.check-row.fail { background: #fdedec; color: #e74c3c; }
.el-item { padding: 16rpx 0; border-bottom: 1rpx solid #ecf0f1; }
.el-item:last-child { border-bottom: none; }
.el-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.el-no { font-size: 22rpx; color: #95a5a6; }
.el-meta { display: flex; justify-content: space-between; font-size: 24rpx; color: #34495e; margin-bottom: 4rpx; }
