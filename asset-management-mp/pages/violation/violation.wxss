.v-page { padding-bottom: 40rpx; }
.page-header { background: linear-gradient(135deg, #c0392b, #8e1c1c); padding: 40rpx 32rpx; color: #fff; }
.page-header .title { font-size: 36rpx; font-weight: 600; }
.page-header .sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.actions { padding: 24rpx; }
.v-item { padding: 16rpx 0; border-bottom: 1rpx solid #ecf0f1; }
.v-item:last-child { border-bottom: none; }
.v-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.v-no { font-size: 22rpx; color: #95a5a6; }
.v-type { font-size: 26rpx; font-weight: 500; margin-bottom: 4rpx; }
.v-desc { font-size: 24rpx; color: #34495e; padding: 8rpx; background: #f5f6fa; border-radius: 6rpx; margin-bottom: 8rpx; }
.v-meta { display: flex; justify-content: space-between; font-size: 22rpx; color: #7f8c8d; margin-bottom: 4rpx; }
