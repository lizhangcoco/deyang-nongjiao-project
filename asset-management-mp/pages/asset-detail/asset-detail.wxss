.detail-page { padding-bottom: 40rpx; }
.tag-header {
  background: linear-gradient(135deg, #c0392b, #8e1c1c);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  color: #fff;
}
.tag-icon { font-size: 56rpx; margin-right: 20rpx; }
.tag-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.soe-alert {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fdecea;
  color: #c0392b;
  border-radius: 12rpx;
  font-size: 26rpx;
  border-left: 6rpx solid #c0392b;
}
.soe-alert-warning {
  background: #fef5e7;
  color: #f39c12;
  border-left-color: #f39c12;
}
.soe-alert .link { float: right; font-weight: 600; }

.info-grid {
  display: flex;
  flex-wrap: wrap;
}
.info-item {
  width: 50%;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
}
.info-item .label {
  font-size: 22rpx;
  color: #95a5a6;
  margin-bottom: 4rpx;
}
.info-item .value {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 16rpx;
  justify-content: center;
}
.actions .btn { flex: 1; min-width: 200rpx; }
