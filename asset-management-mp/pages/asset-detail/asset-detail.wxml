<view class="detail-page" wx:if="{{asset}}">
  <!-- 电子标牌头 -->
  <view class="tag-header">
    <view class="tag-icon">🏷️</view>
    <view class="tag-title">{{asset.asset_name}}</view>
    <status-tag status="{{asset.status}}" />
  </view>

  <!-- SOE合规提示 -->
  <view class="soe-alert" wx:if="{{majorDecisionTriggered}}">
    ⚖️ 触发三重一大决策(单笔≥100万) <text class="link" bindtap="onMajorDecision">去发起 ›</text>
  </view>
  <view class="soe-alert soe-alert-warning" wx:if="{{appraisalRequired}}">
    💯 处置前需强制资产评估 <text class="link" bindtap="onAppraisal">去评估 ›</text>
  </view>

  <!-- 电子标牌强制字段(59号制度3.5条) -->
  <view class="card">
    <view class="card-title">资产电子标牌 <text class="soe-badge">强制</text></view>
    <view class="info-grid">
      <view class="info-item"><text class="label">资产编号</text><text class="value">{{asset.asset_code}}</text></view>
      <view class="info-item"><text class="label">资产名称</text><text class="value">{{asset.asset_name}}</text></view>
      <view class="info-item"><text class="label">原值</text><text class="value text-primary">¥{{asset.original_value}}</text></view>
      <view class="info-item"><text class="label">启用日期</text><text class="value">{{asset.enable_date}}</text></view>
      <view class="info-item"><text class="label">归口部门</text><text class="value">{{asset.manage_dept_role}}</text></view>
      <view class="info-item"><text class="label">使用部门</text><text class="value">{{asset.use_dept_id}}</text></view>
      <view class="info-item"><text class="label">使用人</text><text class="value">{{asset.use_user_id || '公共'}}</text></view>
      <view class="info-item"><text class="label">存放地点</text><text class="value">{{asset.location}}</text></view>
      <view class="info-item"><text class="label">资产状态</text><text class="value">{{asset.status_label}}</text></view>
    </view>
  </view>

  <!-- 分类与价值 -->
  <view class="card">
    <view class="card-title">分类与价值</view>
    <view class="info-grid">
      <view class="info-item"><text class="label">一级分类</text><text class="value">{{asset.category_l1}}</text></view>
      <view class="info-item"><text class="label">二级分类</text><text class="value">{{asset.category_l2_label}}</text></view>
      <view class="info-item"><text class="label">资产类型</text><text class="value">{{asset.asset_type_label}}</text></view>
      <view class="info-item"><text class="label">数量</text><text class="value">{{asset.quantity}}</text></view>
      <view class="info-item"><text class="label">单价</text><text class="value">¥{{asset.unit_price}}</text></view>
      <view class="info-item"><text class="label">累计折旧</text><text class="value">¥{{asset.acc_depreciation}}</text></view>
      <view class="info-item"><text class="label">账面价值</text><text class="value">¥{{asset.book_value}}</text></view>
      <view class="info-item"><text class="label">净残值率</text><text class="value">{{asset.residual_rate * 100}}%</text></view>
      <view class="info-item"><text class="label">折旧年限</text><text class="value">{{asset.useful_life_years}}年</text></view>
    </view>
  </view>

  <!-- 特殊标记 -->
  <view class="card" wx:if="{{asset.is_public || asset.is_leader_asset || asset.related_external_system}}">
    <view class="card-title">特殊属性</view>
    <view class="info-grid">
      <view class="info-item" wx:if="{{asset.is_public}}"><text class="label">公共资产</text><text class="value text-warning">是</text></view>
      <view class="info-item" wx:if="{{asset.is_leader_asset}}"><text class="label">领导专用</text><text class="value text-warning">是</text></view>
      <view class="info-item" wx:if="{{asset.related_external_system}}"><text class="label">外部系统</text><text class="value text-info">{{asset.related_external_system}}</text></view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn btn-ghost" wx:if="{{showReceive}}" bindtap="onReceive">领用</button>
    <button class="btn btn-info" wx:if="{{showTransfer}}" bindtap="onTransfer">调拨</button>
    <button class="btn btn-warning" wx:if="{{showRepair}}" bindtap="onRepair">维修</button>
    <button class="btn btn-danger" wx:if="{{showScrap}}" bindtap="onScrap">报废</button>
    <button class="btn btn-primary" wx:if="{{showExchange}}" bindtap="onExchange">进场交易</button>
  </view>

  <view class="safe-bottom"></view>
</view>
