.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #c0392b 0%, #8e1c1c 50%, #f5f6fa 50%, #f5f6fa 100%);
}
.header {
  text-align: center;
  padding: 80rpx 0 60rpx;
  color: #fff;
}
.logo {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}
.subtitle {
  font-size: 30rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}
.soe-tag {
  display: inline-block;
  margin-top: 20rpx;
  padding: 6rpx 20rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 8rpx;
  font-size: 22rpx;
}
.version {
  font-size: 22rpx;
  margin-top: 16rpx;
  opacity: 0.7;
}
.form {
  margin: 0 40rpx;
  padding: 30rpx;
}
.form .form-group {
  border-bottom: 1rpx solid #ecf0f1;
  padding: 24rpx 0;
}
.quick-section {
  margin-top: 40rpx;
  padding: 0 40rpx;
}
.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.quick-item {
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  border: 1rpx solid #ecf0f1;
}
.quick-name {
  font-size: 26rpx;
  color: #2c3e50;
  font-weight: 500;
}
.quick-role {
  font-size: 22rpx;
  color: #95a5a6;
  margin-top: 4rpx;
}
.footer {
  text-align: center;
  padding: 40rpx;
  font-size: 22rpx;
  color: #95a5a6;
}
