.inventory-page { padding-bottom: 40rpx; }
.page-header { background: linear-gradient(135deg, #c0392b, #8e1c1c); padding: 40rpx 32rpx; color: #fff; }
.page-header .title { font-size: 36rpx; font-weight: 600; }
.page-header .sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.inv-item { padding: 16rpx 0; border-bottom: 1rpx solid #ecf0f1; }
.inv-item:last-child { border-bottom: none; }
.inv-title { font-size: 28rpx; font-weight: 500; color: #2c3e50; margin-bottom: 8rpx; }
.inv-meta { display: flex; gap: 16rpx; font-size: 22rpx; color: #95a5a6; align-items: center; }
.inv-progress { font-size: 22rpx; color: #3498db; margin-top: 4rpx; }
.actions { padding: 24rpx; }
