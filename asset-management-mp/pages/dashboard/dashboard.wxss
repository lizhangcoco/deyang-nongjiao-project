.dashboard { padding-bottom: 40rpx; }
.user-header {
  background: linear-gradient(135deg, #c0392b, #8e1c1c);
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.user-info { display: flex; align-items: center; flex: 1; }
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 24rpx;
}
.info { flex: 1; }
.info .name {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
}
.info .org {
  color: rgba(255,255,255,0.85);
  font-size: 24rpx;
  margin-top: 6rpx;
}
.info .role {
  color: rgba(255,255,255,0.7);
  font-size: 22rpx;
  margin-top: 4rpx;
}
.scan-btn {
  background: rgba(255,255,255,0.2);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  color: #fff;
  text-align: center;
  font-size: 22rpx;
}
.scan-icon { display: block; font-size: 40rpx; margin-bottom: 4rpx; }

.stats-grid {
  display: flex;
  background: #fff;
  margin: -20rpx 24rpx 0;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 1;
}
.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #ecf0f1;
}
.stat-item:last-child { border-right: none; }
.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #2c3e50;
}
.stat-label {
  font-size: 22rpx;
  color: #95a5a6;
  margin-top: 8rpx;
}

.value-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #34495e;
}

.warning-list { font-size: 26rpx; }
.warning-item {
  padding: 12rpx 0;
  color: #e74c3c;
  border-bottom: 1rpx dashed #fdedec;
}

.empty-mini { text-align: center; padding: 30rpx; color: #95a5a6; font-size: 24rpx; }
.approval-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ecf0f1;
}
.approval-item:last-child { border-bottom: none; }
.approval-title {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.approval-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #95a5a6;
}
.approval-meta .amount { color: #c0392b; }
.approval-step {
  font-size: 22rpx;
  color: #3498db;
  margin-top: 4rpx;
}

.more { font-size: 22rpx; color: #95a5a6; float: right; }

.menu-grid {
  display: flex;
  flex-wrap: wrap;
}
.menu-item {
  width: 25%;
  padding: 24rpx 0;
  text-align: center;
}
.menu-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}
.menu-name {
  font-size: 22rpx;
  color: #34495e;
}

.safe-bottom { height: 40rpx; }
