.profile-page { padding-bottom: 40rpx; }
.user-header {
  background: linear-gradient(135deg, #c0392b, #8e1c1c);
  padding: 60rpx 32rpx;
  display: flex;
  align-items: center;
  color: #fff;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 600;
  margin-right: 24rpx;
}
.info { flex: 1; }
.info .name { font-size: 36rpx; font-weight: 600; }
.info .org { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }
.info .dept { font-size: 22rpx; opacity: 0.7; margin-top: 4rpx; }
.info .role { font-size: 22rpx; opacity: 0.7; margin-top: 2rpx; }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 26rpx; border-bottom: 1rpx dashed #ecf0f1; }
.info-row:last-child { border-bottom: none; }
.info-row text:first-child { color: #7f8c8d; }
.policy-item { padding: 16rpx 0; border-bottom: 1rpx solid #ecf0f1; }
.policy-item:last-child { border-bottom: none; }
.policy-name { font-size: 26rpx; color: #2c3e50; font-weight: 500; margin-bottom: 8rpx; }
.policy-meta { display: flex; justify-content: space-between; align-items: center; font-size: 22rpx; color: #95a5a6; margin-bottom: 8rpx; }
.policy-actions { display: flex; gap: 16rpx; }
.policy-actions .btn { flex: 1; }
.actions { padding: 24rpx; }
