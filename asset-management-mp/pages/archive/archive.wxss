.archive-page { padding-bottom: 40rpx; }
.page-header { background: linear-gradient(135deg, #c0392b, #8e1c1c); padding: 40rpx 32rpx; color: #fff; }
.page-header .title { font-size: 36rpx; font-weight: 600; }
.page-header .sub { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }
.archive-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 16rpx;
}
.archive-item {
  width: calc(33.333% - 12rpx);
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.archive-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.archive-name { font-size: 22rpx; color: #2c3e50; font-weight: 500; }
.archive-count { font-size: 20rpx; color: #95a5a6; margin-top: 4rpx; }
.info-row { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 26rpx; border-bottom: 1rpx dashed #ecf0f1; }
.info-row:last-child { border-bottom: none; }
.info-row text:first-child { color: #7f8c8d; }
