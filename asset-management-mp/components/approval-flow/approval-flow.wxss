.flow {
  padding: 24rpx;
}
.flow-item {
  display: flex;
  align-items: center;
  margin-bottom: 0;
  position: relative;
}
.dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ecf0f1;
  color: #95a5a6;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  z-index: 1;
}
.flow-item.done .dot {
  background: #27ae60;
  color: #fff;
}
.flow-item.current .dot {
  background: #c0392b;
  color: #fff;
  box-shadow: 0 0 0 8rpx rgba(192, 57, 43, 0.15);
}
.info {
  flex: 1;
}
.step-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}
.step-role {
  font-size: 22rpx;
  color: #95a5a6;
}
.flow-line {
  width: 4rpx;
  height: 40rpx;
  background: #ecf0f1;
  margin-left: 26rpx;
}
.flow-line.active {
  background: #27ae60;
}
